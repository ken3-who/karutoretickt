<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>HEARTS デジタル会員証</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Noto Sans JP -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- QR Code Generator Library (QRious) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>
  <!-- Confetti Library -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    body {
      font-family: 'Inter', 'Noto Sans JP', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    /* スクリーンショット不正防止風の光沢・パルスアニメーション */
    @keyframes shimmerSweep {
      0% { transform: translateX(-150%) skewX(-20deg); }
      45%, 100% { transform: translateX(250%) skewX(-20deg); }
    }
    .card-shimmer::after {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 40%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
      animation: shimmerSweep 5s infinite ease-in-out;
      pointer-events: none;
    }

    @keyframes livePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.25); }
    }
    .live-dot {
      animation: livePulse 1.4s infinite ease-in-out;
    }

    /* スタンプ押印アニメーション */
    @keyframes stampDrop {
      0% {
        opacity: 0;
        transform: scale(2.4) rotate(-25deg);
      }
      60% {
        opacity: 1;
        transform: scale(0.9) rotate(4deg);
      }
      80% {
        transform: scale(1.06) rotate(-2deg);
      }
      100% {
        opacity: 1;
        transform: scale(1) rotate(-4deg);
      }
    }
    .stamp-animate {
      animation: stampDrop 0.48s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* スクロールバー非表示（スマホUI向け） */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-slate-200 text-slate-800 min-h-screen flex justify-center items-start sm:py-6">

  <!-- スマホフレームコンテナ -->
  <div class="w-full max-w-[430px] bg-slate-50 min-h-screen sm:min-h-[844px] sm:rounded-[36px] sm:shadow-2xl sm:border sm:border-slate-300/80 flex flex-col relative overflow-hidden">

    <!-- トップヘッダー -->
    <header class="bg-[#0B1528] text-white px-5 pt-4 pb-3.5 flex items-center justify-between sticky top-0 z-20 shadow-md">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-inner">
          <!-- ボクシング＆体軸モチーフアイコン -->
          <svg class="w-5 h-5 text-[#0B1528]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L14.8 8.2L21.5 9L16.5 13.6L17.9 20.3L12 17L6.1 20.3L7.5 13.6L2.5 9L9.2 8.2L12 2Z" />
          </svg>
        </div>
        <div>
          <p class="text-[10px] tracking-widest text-amber-400 font-bold uppercase">DIGITAL MEMBER PASS</p>
          <h1 id="headerGymName" class="text-sm font-bold tracking-tight truncate max-w-[230px]">HEARTS ボクシングジム</h1>
        </div>
      </div>

      <!-- モード切替ピル（テスト / スタッフPIN） -->
      <button id="modeToggleBtn" type="button" onclick="toggleStampMode()" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-full border transition flex items-center gap-1.5 bg-slate-800/90 border-slate-700 text-slate-200 active:scale-95">
        <span id="modeDot" class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span id="modeLabel">ワンタップ体験</span>
      </button>
    </header>

    <!-- メインコンテンツエリア（スクロール可能） -->
    <main class="flex-1 overflow-y-auto no-scrollbar pb-24 px-4 pt-4">

      <!-- ==================== タブ1：会員証＆スタンプ ==================== -->
      <section id="tab-card" class="space-y-4">

        <!-- デジタル会員証カード -->
        <div id="memberCardBg" class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0F1E36] via-[#16294A] to-[#0A1324] text-white p-5 shadow-xl border border-amber-400/30 card-shimmer">
          <!-- 装飾用の背景サークル -->
          <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-amber-400/10 blur-xl pointer-events-none"></div>
          <div class="absolute -left-10 -bottom-12 w-36 h-36 rounded-full bg-sky-400/10 blur-xl pointer-events-none"></div>

          <!-- 上段：ジム名・ランクバッジ -->
          <div class="flex justify-between items-start gap-2 relative z-10">
            <div>
              <h2 id="cardGymTitle" class="text-base font-extrabold tracking-wide text-white leading-snug">HEARTS ボクシングジム</h2>
              <p id="cardGymSub" class="text-xs text-amber-300/90 font-medium mt-0.5">体軸トレーニング</p>
            </div>
            <span id="rankBadge" class="px-3 py-1 rounded-full text-[11px] font-extrabold tracking-wider uppercase bg-gradient-to-r from-amber-600 to-amber-400 text-slate-950 shadow">
              BRONZE
            </span>
          </div>

          <!-- 中段：会員情報 ＋ QRコード -->
          <div class="mt-5 flex items-end justify-between gap-3 relative z-10">
            <div class="space-y-2.5 flex-1 min-w-0">
              <div>
                <span class="text-[10px] uppercase tracking-widest text-slate-400 block">MEMBER NO.</span>
                <p id="cardMemberNo" class="text-sm font-mono font-bold tracking-wider text-amber-300">No. 00124</p>
              </div>
              <div>
                <span class="text-[10px] uppercase tracking-widest text-slate-400 block">NAME</span>
                <p id="cardMemberName" class="text-xl font-bold tracking-tight text-white truncate">ゲスト会員 様</p>
              </div>
              <div class="pt-0.5">
                <span id="cardCourseName" class="inline-block text-[11px] font-medium px-2.5 py-1 rounded-lg bg-white/10 text-slate-100 border border-white/15">
                  体軸・コンディショニングコース
                </span>
              </div>
            </div>

            <!-- QRコードボックス -->
            <div class="bg-white p-2 rounded-2xl shadow-md flex flex-col items-center shrink-0">
              <canvas id="qrCanvas" class="w-[78px] h-[78px]"></canvas>
              <span class="text-[9px] font-bold text-slate-700 mt-1 tracking-tighter">CHECK-IN QR</span>
            </div>
          </div>

          <!-- 下段：リアルタイム時計＆不正防止ライブ表示 -->
          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] relative z-10">
            <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
              <span>ACTIVE PASS</span>
            </div>
            <div id="liveClock" class="font-mono font-semibold text-slate-200 tracking-wide">
              2026/11/23 13:30:00
            </div>
          </div>
        </div>

        <!-- ステータスサマリーバー -->
        <div class="grid grid-cols-3 gap-2.5">
          <div class="bg-white rounded-2xl p-3 border border-slate-200/80 shadow-sm text-center">
            <p class="text-[10px] font-semibold text-slate-400">現在のカード</p>
            <p class="text-sm font-extrabold text-slate-800 mt-0.5"><span id="statCardNum">1</span> <span class="text-xs font-normal">枚目</span></p>
          </div>
          <div class="bg-white rounded-2xl p-3 border border-slate-200/80 shadow-sm text-center">
            <p class="text-[10px] font-semibold text-slate-400">累計スタンプ</p>
            <p class="text-sm font-extrabold text-slate-800 mt-0.5"><span id="statTotalStamps">0</span> <span class="text-xs font-normal">個</span></p>
          </div>
          <div class="bg-white rounded-2xl p-3 border border-slate-200/80 shadow-sm text-center">
            <p class="text-[10px] font-semibold text-slate-400">未使用特典</p>
            <p class="text-sm font-extrabold text-amber-600 mt-0.5"><span id="statTicketsCount">0</span> <span class="text-xs font-normal text-slate-700">枚</span></p>
          </div>
        </div>

        <!-- スタンプカードセクション -->
        <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/90">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-sm font-extrabold text-slate-800 flex items-center gap-1.5">
                <span class="w-1.5 h-4 rounded-full bg-amber-500 inline-block"></span>
                トレーニングスタンプ
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5">10個達成で特典チケットを獲得！</p>
            </div>
            <div class="text-right">
              <span id="stampProgressText" class="text-lg font-extrabold text-[#0F1E36]">0</span>
              <span class="text-xs font-bold text-slate-400">/ 10</span>
            </div>
          </div>

          <!-- 進捗バー -->
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden mb-4">
            <div id="stampProgressBar" class="h-full bg-gradient-to-r from-[#0F1E36] via-amber-500 to-amber-400 transition-all duration-500 rounded-full" style="width: 0%;"></div>
          </div>

          <!-- 10マススタンプグリッド（5列×2段） -->
          <div id="stampGrid" class="grid grid-cols-5 gap-2.5">
            <!-- JSで10マス描画 -->
          </div>

          <!-- 特典ゴール案内 -->
          <div class="mt-4 p-3 rounded-2xl bg-amber-50/90 border border-amber-200/80 flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 font-bold text-xs shadow-sm">
              GOAL
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[10px] font-bold text-amber-800">10個達成特典</p>
              <p id="cardRewardPreview" class="text-xs font-bold text-slate-800 truncate">パーソナル体軸チェック1回無料</p>
            </div>
          </div>

          <!-- アクションボタンエリア -->
          <div class="mt-4">
            <!-- 通常時：スタンプ押印ボタン -->
            <button id="stampActionBtn" type="button" onclick="handleStampButtonClick()" class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-[#0F1E36] to-[#1D355E] hover:from-[#162B4D] hover:to-[#244173] text-white font-bold text-sm shadow-lg shadow-slate-900/15 active:scale-[0.98] transition flex items-center justify-center gap-2">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span id="stampActionBtnText">本日のスタンプを押す（体験モード）</span>
            </button>

            <!-- 10個満タン時：特典使用＆次カードへボタン -->
            <button id="completeCardBtn" type="button" onclick="advanceToNextCard()" class="hidden w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-white font-extrabold text-sm shadow-lg shadow-amber-500/30 active:scale-[0.98] transition flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
              </svg>
              <span>特典を獲得して次のカードへ進む</span>
            </button>
          </div>
        </div>
      </section>

      <!-- ==================== タブ2：特典・来店履歴 ==================== -->
      <section id="tab-history" class="hidden space-y-5">

        <!-- 保有特典チケット一覧 -->
        <div>
          <div class="flex items-center justify-between mb-2.5 px-1">
            <h2 class="text-sm font-extrabold text-slate-800 flex items-center gap-1.5">
              <span class="w-1.5 h-4 rounded-full bg-amber-500 inline-block"></span>
              獲得した特典チケット
            </h2>
            <span id="ticketBadgeCount" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">0枚</span>
          </div>

          <div id="ticketsList" class="space-y-2.5">
            <!-- JSでチケット描画 -->
          </div>
        </div>

        <!-- 来店・スタンプ獲得履歴 -->
        <div>
          <div class="flex items-center justify-between mb-2.5 px-1">
            <h2 class="text-sm font-extrabold text-slate-800 flex items-center gap-1.5">
              <span class="w-1.5 h-4 rounded-full bg-[#0F1E36] inline-block"></span>
              来店・スタンプ履歴
            </h2>
            <span id="historyTotalLabel" class="text-xs font-medium text-slate-500">全 0 件</span>
          </div>

          <div id="historyList" class="bg-white rounded-3xl border border-slate-200/90 divide-y divide-slate-100 overflow-hidden shadow-sm">
            <!-- JSで履歴描画 -->
          </div>
        </div>
      </section>

      <!-- ==================== タブ3：設定・カスタマイズ ==================== -->
      <section id="tab-settings" class="hidden space-y-4">
        <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm space-y-4">
          <div class="border-b border-slate-100 pb-3">
            <h2 class="text-base font-extrabold text-slate-800">会員証・店舗カスタマイズ</h2>
            <p class="text-xs text-slate-500 mt-0.5">変更内容は自動的に端末へ保存されます。</p>
          </div>

          <!-- 店舗名 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">ジム・店舗名</label>
            <input id="inputGymName" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="HEARTS ボクシングジム" />
          </div>

          <!-- サブタイトル -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">プログラム・サブタイトル</label>
            <input id="inputGymSub" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="体軸トレーニング" />
          </div>

          <!-- 会員氏名 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">会員氏名</label>
              <input id="inputMemberName" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="ゲスト会員 様" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">会員番号</label>
              <input id="inputMemberNo" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="00124" />
            </div>
          </div>

          <!-- コース選択 / 自由入力 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">会員コース・プラン</label>
            <select id="selectCoursePreset" onchange="applyCoursePreset()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm bg-white mb-2 focus:outline-none focus:ring-2 focus:ring-amber-500">
              <option value="体軸・コンディショニングコース">体軸・コンディショニングコース</option>
              <option value="レギュラー会員（ボクシング＆体軸）">レギュラー会員（ボクシング＆体軸）</option>
              <option value="パーソナル体軸集中プラン">パーソナル体軸集中プラン</option>
              <option value="デイタイム・フィットネス会員">デイタイム・フィットネス会員</option>
              <option value="custom">自由に入力する...</option>
            </select>
            <input id="inputCourseName" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="コース名を入力" />
          </div>

          <!-- 満タン時の特典内容 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">スタンプ10個達成時の特典内容</label>
            <input id="inputRewardText" type="text" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="パーソナル体軸チェック1回無料" />
          </div>

          <!-- スタッフPINコード -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">スタッフ確認用PINコード（数字4桁）</label>
            <input id="inputStaffPin" type="password" inputmode="numeric" maxlength="4" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="1234" />
            <p class="text-[11px] text-slate-400 mt-1">初期値：1234（「スタッフ認証」モード時に要求されます）</p>
          </div>

          <button type="button" onclick="saveSettings()" class="w-full py-3 rounded-2xl bg-[#0F1E36] text-white font-bold text-sm shadow-md active:scale-[0.98] transition">
            設定を保存する
          </button>
        </div>

        <!-- データ管理・リセット -->
        <div class="bg-white rounded-3xl p-5 border border-rose-200/80 shadow-sm space-y-3">
          <h3 class="text-xs font-extrabold text-rose-600 uppercase tracking-wider">データ管理</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            スタンプ数・履歴・特典チケット・会員設定をすべて初期状態に戻します。
          </p>
          <button type="button" onclick="openResetConfirmModal()" class="w-full py-2.5 rounded-xl border border-rose-300 text-rose-600 font-bold text-xs hover:bg-rose-50 active:scale-[0.98] transition">
            すべてのデータを初期化する
          </button>
        </div>
      </section>

    </main>

    <!-- 下部固定ナビゲーションバー -->
    <nav class="bg-white/95 backdrop-blur-md border-t border-slate-200 px-3 py-2 flex justify-around items-center sticky bottom-0 z-20">
      <button type="button" onclick="switchTab('card')" id="nav-card" class="flex-1 py-1.5 flex flex-col items-center gap-1 rounded-2xl text-[#0F1E36] font-bold transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" />
        </svg>
        <span class="text-[11px]">会員証</span>
      </button>

      <button type="button" onclick="switchTab('history')" id="nav-history" class="flex-1 py-1.5 flex flex-col items-center gap-1 rounded-2xl text-slate-400 font-medium transition relative">
        <span id="navTicketDot" class="hidden absolute top-1.5 right-7 w-2.5 h-2.5 rounded-full bg-amber-500 ring-2 ring-white"></span>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
        </svg>
        <span class="text-[11px]">特典・履歴</span>
      </button>

      <button type="button" onclick="switchTab('settings')" id="nav-settings" class="flex-1 py-1.5 flex flex-col items-center gap-1 rounded-2xl text-slate-400 font-medium transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="text-[11px]">設定</span>
      </button>
    </nav>

    <!-- ==================== モーダル：スタッフPIN入力 ==================== -->
    <div id="pinModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white w-full max-w-[340px] rounded-3xl p-6 shadow-2xl space-y-4">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-[#0F1E36] text-amber-400 flex items-center justify-center mx-auto mb-2.5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h3 class="text-base font-extrabold text-slate-800">スタッフ確認</h3>
          <p class="text-xs text-slate-500 mt-1">スタッフ用PINコード（4桁）を入力してください</p>
        </div>

        <div>
          <input id="pinModalInput" type="password" inputmode="numeric" maxlength="4" class="w-full text-center text-2xl font-mono font-bold tracking-[0.5em] py-3 rounded-2xl border-2 border-slate-200 focus:border-amber-500 focus:outline-none" placeholder="••••" />
          <p id="pinErrorMsg" class="hidden text-xs text-rose-600 font-bold text-center mt-2">PINコードが正しくありません</p>
        </div>

        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <button type="button" onclick="closePinModal()" class="py-2.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-xs active:scale-95 transition">
            キャンセル
          </button>
          <button type="button" onclick="verifyPinAndStamp()" class="py-2.5 rounded-xl bg-[#0F1E36] text-white font-bold text-xs shadow active:scale-95 transition">
            認証して押印
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== モーダル：満タン達成お祝い ==================== -->
    <div id="congratsModal" class="hidden fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white w-full max-w-[350px] rounded-3xl p-6 shadow-2xl text-center space-y-4 border-2 border-amber-400">
        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 text-white flex items-center justify-center mx-auto shadow-lg">
          <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </div>
        <div>
          <span class="text-[11px] font-extrabold tracking-widest text-amber-600 uppercase">CONGRATULATIONS!</span>
          <h3 class="text-xl font-extrabold text-slate-900 mt-0.5">スタンプ10個達成！</h3>
          <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
            継続的なトレーニングお疲れ様です！<br>達成特典チケットが発行されました。
          </p>
        </div>

        <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200">
          <p class="text-[10px] font-bold text-amber-800">獲得特典</p>
          <p id="modalRewardTitle" class="text-sm font-extrabold text-slate-900 mt-0.5">パーソナル体軸チェック1回無料</p>
        </div>

        <div class="space-y-2 pt-1">
          <button type="button" onclick="advanceToNextCard()" class="w-full py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-white font-extrabold text-sm shadow-md active:scale-95 transition">
            次のカード（ランクアップ）へ進む
          </button>
          <button type="button" onclick="closeCongratsModal()" class="w-full py-2 text-xs font-bold text-slate-400 hover:text-slate-600">
            あとで更新する
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== モーダル：カスタム確認ダイアログ ==================== -->
    <div id="confirmModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white w-full max-w-[330px] rounded-3xl p-6 shadow-2xl space-y-4">
        <h3 id="confirmModalTitle" class="text-base font-extrabold text-slate-800">確認</h3>
        <p id="confirmModalDesc" class="text-xs text-slate-600 leading-relaxed">実行してもよろしいですか？</p>
        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <button type="button" onclick="closeConfirmModal()" class="py-2.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-xs active:scale-95 transition">
            キャンセル
          </button>
          <button id="confirmModalOkBtn" type="button" class="py-2.5 rounded-xl bg-rose-600 text-white font-bold text-xs shadow active:scale-95 transition">
            実行する
          </button>
        </div>
      </div>
    </div>

    <!-- トースト通知 -->
    <div id="toast" class="pointer-events-none fixed bottom-20 left-1/2 -translate-x-1/2 z-50 opacity-0 transition-all duration-300 translate-y-2">
      <div id="toastInner" class="bg-slate-900/95 text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-lg flex items-center gap-2 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span id="toastText">保存しました</span>
      </div>
    </div>

  </div>

  <script>
    // ==========================================
    // 1. アプリケーション状態管理 (localStorage)
    // ==========================================
    const STORAGE_KEY = 'hearts_boxing_axis_member_v1';

    const DEFAULT_STATE = {
      gymName: 'HEARTS ボクシングジム',
      gymSub: '体軸トレーニング',
      memberNo: '00124',
      memberName: 'ゲスト会員 様',
      courseName: '体軸・コンディショニングコース',
      rewardText: 'パーソナル体軸チェック1回無料',
      staffPin: '1234',
      testMode: true, // true: ワンタップ体験モード, false: スタッフPINモード
      cardCount: 1,   // 現在のカード枚目 (1: BRONZE, 2: SILVER, 3: GOLD, 4+: PLATINUM)
      totalStamps: 0,
      stamps: [],     // [{ date: '11/23', fullDate: '2026/11/23 13:30' }]
      tickets: [],    // [{ id, title, earnedAt, used: false, usedAt: null }]
      history: []     // [{ id, date, label, detail }]
    };

    let appState = loadState();
    let qrInstance = null;
    let pendingConfirmAction = null;

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return JSON.parse(JSON.stringify(DEFAULT_STATE));
        return { ...JSON.parse(JSON.stringify(DEFAULT_STATE)), ...JSON.parse(raw) };
      } catch (e) {
        console.error('Failed to load state:', e);
        return JSON.parse(JSON.stringify(DEFAULT_STATE));
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.error('Failed to save state:', e);
      }
    }

    // ==========================================
    // 2. 初期化 & リアルタイム時計・QRコード
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      initQR();
      startLiveClock();
      renderAll();
    });

    function initQR() {
      const canvas = document.getElementById('qrCanvas');
      qrInstance = new QRious({
        element: canvas,
        size: 160,
        value: `HEARTS-MEMBER-${appState.memberNo}`,
        foreground: '#0F1E36',
        background: '#FFFFFF',
        level: 'M'
      });
    }

    function updateQR() {
      if (qrInstance) {
        qrInstance.value = `HEARTS-MEMBER-${appState.memberNo}`;
      }
    }

    function startLiveClock() {
      const clockEl = document.getElementById('liveClock');
      const update = () => {
        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        const ss = String(now.getSeconds()).padStart(2, '0');
        clockEl.textContent = `${y}/${m}/${d} ${hh}:${mm}:${ss}`;
      };
      update();
      setInterval(update, 1000);
    }

    // ==========================================
    // 3. UI全体レンダリング
    // ==========================================
    function renderAll() {
      renderHeaderAndMode();
      renderMemberCard();
      renderStampGrid();
      renderHistoryAndTickets();
      populateSettingsForm();
    }

    function renderHeaderAndMode() {
      document.getElementById('headerGymName').textContent = appState.gymName;

      const modeDot = document.getElementById('modeDot');
      const modeLabel = document.getElementById('modeLabel');
      const actionBtnText = document.getElementById('stampActionBtnText');

      if (appState.testMode) {
        modeDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        modeLabel.textContent = 'ワンタップ体験';
        actionBtnText.textContent = '本日のスタンプを押す（体験モード）';
      } else {
        modeDot.className = 'w-2 h-2 rounded-full bg-amber-400';
        modeLabel.textContent = 'スタッフPIN認証';
        actionBtnText.textContent = 'スタッフ用：スタンプを押す';
      }
    }

    function getRankInfo(cardCount) {
      if (cardCount === 1) {
        return {
          name: 'BRONZE',
          badgeClass: 'bg-gradient-to-r from-amber-700 to-amber-500 text-white',
          cardClass: 'from-[#0F1E36] via-[#16294A] to-[#0A1324] border-amber-400/30'
        };
      } else if (cardCount === 2) {
        return {
          name: 'SILVER',
          badgeClass: 'bg-gradient-to-r from-slate-300 via-white to-slate-300 text-slate-900',
          cardClass: 'from-[#162238] via-[#263859] to-[#0F172A] border-slate-300/40'
        };
      } else if (cardCount === 3) {
        return {
          name: 'GOLD',
          badgeClass: 'bg-gradient-to-r from-yellow-500 via-amber-300 to-yellow-500 text-slate-950',
          cardClass: 'from-[#1D1A10] via-[#2E2612] to-[#0F172A] border-amber-400/60'
        };
      } else {
        return {
          name: 'PLATINUM',
          badgeClass: 'bg-gradient-to-r from-cyan-300 via-white to-indigo-300 text-slate-950',
          cardClass: 'from-[#090D16] via-[#1B243B] to-[#090D16] border-cyan-300/50'
        };
      }
    }

    function renderMemberCard() {
      const rank = getRankInfo(appState.cardCount);
      document.getElementById('cardGymTitle').textContent = appState.gymName;
      document.getElementById('cardGymSub').textContent = appState.gymSub;
      document.getElementById('cardMemberNo').textContent = `No. ${appState.memberNo}`;
      document.getElementById('cardMemberName').textContent = appState.memberName;
      document.getElementById('cardCourseName').textContent = appState.courseName;

      const rankBadge = document.getElementById('rankBadge');
      rankBadge.textContent = rank.name;
      rankBadge.className = `px-3 py-1 rounded-full text-[11px] font-extrabold tracking-wider uppercase shadow ${rank.badgeClass}`;

      const cardEl = document.getElementById('memberCardBg');
      cardEl.className = `relative overflow-hidden rounded-3xl bg-gradient-to-br ${rank.cardClass} text-white p-5 shadow-xl border card-shimmer`;

      // サマリー統計
      document.getElementById('statCardNum').textContent = appState.cardCount;
      document.getElementById('statTotalStamps').textContent = appState.totalStamps;
      const unusedTickets = appState.tickets.filter(t => !t.used).length;
      document.getElementById('statTicketsCount').textContent = unusedTickets;

      // ナビゲーションバッジ
      const navDot = document.getElementById('navTicketDot');
      if (unusedTickets > 0) {
        navDot.classList.remove('hidden');
      } else {
        navDot.classList.add('hidden');
      }

      updateQR();
    }

    function renderStampGrid(animateIndex = -1) {
      const grid = document.getElementById('stampGrid');
      grid.innerHTML = '';
      const count = appState.stamps.length;

      document.getElementById('stampProgressText').textContent = count;
      document.getElementById('stampProgressBar').style.width = `${(count / 10) * 100}%`;
      document.getElementById('cardRewardPreview').textContent = appState.rewardText;

      for (let i = 0; i < 10; i++) {
        const isStamped = i < count;
        const isGoal = i === 9;
        const cell = document.createElement('div');

        if (isStamped) {
          const stampData = appState.stamps[i];
          cell.className = `aspect-square rounded-2xl bg-gradient-to-br from-[#0F1E36] to-[#1E3A68] border-2 border-amber-400 flex flex-col items-center justify-center p-1 shadow-sm relative overflow-hidden ${i === animateIndex ? 'stamp-animate' : ''}`;
          cell.innerHTML = `
            <div class="w-7 h-7 rounded-full border border-amber-400/70 flex items-center justify-center text-amber-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L14.8 8.2L21.5 9L16.5 13.6L17.9 20.3L12 17L6.1 20.3L7.5 13.6L2.5 9L9.2 8.2L12 2Z" />
              </svg>
            </div>
            <span class="text-[9px] font-mono font-bold text-white mt-0.5 tracking-tighter">${stampData.date}</span>
          `;
        } else {
          cell.className = `aspect-square rounded-2xl border-2 border-dashed ${isGoal ? 'border-amber-400 bg-amber-50/70' : 'border-slate-200 bg-slate-50'} flex flex-col items-center justify-center p-1`;
          cell.innerHTML = `
            <span class="text-xs font-extrabold ${isGoal ? 'text-amber-600' : 'text-slate-300'}">${i + 1}</span>
            ${isGoal ? '<span class="text-[8px] font-extrabold text-amber-600 uppercase">GOAL</span>' : ''}
          `;
        }
        grid.appendChild(cell);
      }

      // ボタン切り替え（10個満タン時は特典獲得ボタンへ）
      const actionBtn = document.getElementById('stampActionBtn');
      const completeBtn = document.getElementById('completeCardBtn');
      if (count >= 10) {
        actionBtn.classList.add('hidden');
        completeBtn.classList.remove('hidden');
      } else {
        actionBtn.classList.remove('hidden');
        completeBtn.classList.add('hidden');
      }
    }

    function renderHistoryAndTickets() {
      // 1. 特典チケット一覧
      const ticketsList = document.getElementById('ticketsList');
      const unusedCount = appState.tickets.filter(t => !t.used).length;
      document.getElementById('ticketBadgeCount').textContent = `未使用 ${unusedCount}枚`;

      if (appState.tickets.length === 0) {
        ticketsList.innerHTML = `
          <div class="bg-white rounded-2xl p-6 border border-slate-200/80 text-center text-xs text-slate-400">
            まだ獲得した特典チケットはありません。<br>スタンプを10個貯めると自動発行されます。
          </div>
        `;
      } else {
        ticketsList.innerHTML = appState.tickets.map(ticket => {
          if (!ticket.used) {
            return `
              <div class="bg-white rounded-2xl p-4 border-2 border-amber-400/80 shadow-sm flex items-center justify-between gap-3 relative overflow-hidden">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded-md bg-amber-500 text-white text-[10px] font-extrabold">未使用</span>
                    <span class="text-[10px] text-slate-400 font-mono">発行: ${ticket.earnedAt}</span>
                  </div>
                  <p class="text-sm font-extrabold text-slate-800 mt-1.5 leading-snug">${escapeHtml(ticket.title)}</p>
                </div>
                <button type="button" onclick="confirmUseTicket('${ticket.id}')" class="shrink-0 px-3.5 py-2.5 rounded-xl bg-[#0F1E36] text-white text-xs font-bold shadow active:scale-95 transition">
                  使用する
                </button>
              </div>
            `;
          } else {
            return `
              <div class="bg-slate-100/80 rounded-2xl p-4 border border-slate-200 flex items-center justify-between gap-3 opacity-70">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded-md bg-slate-300 text-slate-700 text-[10px] font-bold">使用済み</span>
                    <span class="text-[10px] text-slate-400 font-mono">使用日: ${ticket.usedAt || '-'}</span>
                  </div>
                  <p class="text-xs font-bold text-slate-600 mt-1 line-through">${escapeHtml(ticket.title)}</p>
                </div>
              </div>
            `;
          }
        }).join('');
      }

      // 2. 来店・スタンプ履歴
      const historyList = document.getElementById('historyList');
      document.getElementById('historyTotalLabel').textContent = `全 ${appState.history.length} 件`;

      if (appState.history.length === 0) {
        historyList.innerHTML = `
          <div class="p-6 text-center text-xs text-slate-400">
            来店・スタンプ履歴はまだありません。
          </div>
        `;
      } else {
        historyList.innerHTML = appState.history.map(item => `
          <div class="p-3.5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-8 h-8 rounded-xl bg-slate-100 text-[#0F1E36] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-bold text-slate-800 truncate">${escapeHtml(item.label)}</p>
                <p class="text-[11px] text-slate-400 font-mono mt-0.5">${item.date}</p>
              </div>
            </div>
            <span class="text-[11px] font-extrabold text-amber-600 shrink-0">${escapeHtml(item.detail)}</span>
          </div>
        `).join('');
      }
    }

    // ==========================================
    // 4. スタンプ押印 & 満タン・ランクアップ処理
    // ==========================================
    function toggleStampMode() {
      appState.testMode = !appState.testMode;
      saveState();
      renderHeaderAndMode();
      showToast(appState.testMode ? 'ワンタップ体験モードに切替ました' : 'スタッフPIN認証モードに切替ました');
    }

    function handleStampButtonClick() {
      if (appState.stamps.length >= 10) return;

      if (appState.testMode) {
        executeAddStamp();
      } else {
        openPinModal();
      }
    }

    function openPinModal() {
      const modal = document.getElementById('pinModal');
      const input = document.getElementById('pinModalInput');
      const err = document.getElementById('pinErrorMsg');
      input.value = '';
      err.classList.add('hidden');
      modal.classList.remove('hidden');
      setTimeout(() => input.focus(), 100);
    }

    function closePinModal() {
      document.getElementById('pinModal').classList.add('hidden');
    }

    function verifyPinAndStamp() {
      const inputVal = document.getElementById('pinModalInput').value.trim();
      if (inputVal === appState.staffPin) {
        closePinModal();
        executeAddStamp();
      } else {
        document.getElementById('pinErrorMsg').classList.remove('hidden');
      }
    }

    function executeAddStamp() {
      if (appState.stamps.length >= 10) return;

      const now = new Date();
      const shortDate = `${now.getMonth() + 1}/${now.getDate()}`;
      const fullDate = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      const newIndex = appState.stamps.length;
      appState.stamps.push({ date: shortDate, fullDate });
      appState.totalStamps += 1;

      appState.history.unshift({
        id: 'hist_' + Date.now(),
        date: fullDate,
        label: `トレーニング来店（${appState.cardCount}枚目・${newIndex + 1}個目）`,
        detail: '+1 STAMP'
      });

      // 10個達成時の処理
      if (appState.stamps.length === 10) {
        appState.tickets.unshift({
          id: 'tkt_' + Date.now(),
          title: appState.rewardText,
          earnedAt: `${now.getFullYear()}/${shortDate}`,
          used: false,
          usedAt: null
        });

        appState.history.unshift({
          id: 'hist_rw_' + Date.now(),
          date: fullDate,
          label: `スタンプ10個達成特典を獲得`,
          detail: 'REWARD'
        });

        saveState();
        renderAll();
        renderStampGrid(newIndex);
        triggerCelebration();
      } else {
        saveState();
        renderAll();
        renderStampGrid(newIndex);
        showToast(`スタンプを押印しました！（${appState.stamps.length}/10）`);
      }
    }

    function triggerCelebration() {
      // 紙吹雪アニメーション
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#F59E0B', '#0F1E36', '#38BDF8', '#FDE68A']
        });
      }
      document.getElementById('modalRewardTitle').textContent = appState.rewardText;
      document.getElementById('congratsModal').classList.remove('hidden');
    }

    function closeCongratsModal() {
      document.getElementById('congratsModal').classList.add('hidden');
    }

    function advanceToNextCard() {
      closeCongratsModal();
      appState.stamps = [];
      appState.cardCount += 1;

      const now = new Date();
      const fullDate = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const rank = getRankInfo(appState.cardCount);

      appState.history.unshift({
        id: 'hist_up_' + Date.now(),
        date: fullDate,
        label: `カード更新（${appState.cardCount}枚目 / ${rank.name}ランク）`,
        detail: 'RANK UP'
      });

      saveState();
      renderAll();
      showToast(`${appState.cardCount}枚目（${rank.name}）へ更新しました！`);
    }

    // ==========================================
    // 5. 特典チケット使用処理
    // ==========================================
    function confirmUseTicket(ticketId) {
      const ticket = appState.tickets.find(t => t.id === ticketId);
      if (!ticket) return;

      openConfirmModal(
        '特典チケットの使用確認',
        `「${ticket.title}」を使用済みにしますか？（スタッフに画面をご提示ください）`,
        () => {
          const now = new Date();
          ticket.used = true;
          ticket.usedAt = `${now.getFullYear()}/${now.getMonth() + 1}/${now.getDate()}`;

          appState.history.unshift({
            id: 'hist_use_' + Date.now(),
            date: `${ticket.usedAt} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`,
            label: `特典使用：${ticket.title}`,
            detail: 'USED'
          });

          saveState();
          renderAll();
          showToast('特典チケットを使用済みにしました');
        }
      );
    }

    // ==========================================
    // 6. タブ切り替え & 設定保存・リセット
    // ==========================================
    function switchTab(tabName) {
      ['card', 'history', 'settings'].forEach(name => {
        const sec = document.getElementById(`tab-${name}`);
        const nav = document.getElementById(`nav-${name}`);
        if (name === tabName) {
          sec.classList.remove('hidden');
          nav.classList.remove('text-slate-400', 'font-medium');
          nav.classList.add('text-[#0F1E36]', 'font-bold');
        } else {
          sec.classList.add('hidden');
          nav.classList.add('text-slate-400', 'font-medium');
          nav.classList.remove('text-[#0F1E36]', 'font-bold');
        }
      });
    }

    function populateSettingsForm() {
      document.getElementById('inputGymName').value = appState.gymName;
      document.getElementById('inputGymSub').value = appState.gymSub;
      document.getElementById('inputMemberName').value = appState.memberName;
      document.getElementById('inputMemberNo').value = appState.memberNo;
      document.getElementById('inputCourseName').value = appState.courseName;
      document.getElementById('inputRewardText').value = appState.rewardText;
      document.getElementById('inputStaffPin').value = appState.staffPin;

      const selectEl = document.getElementById('selectCoursePreset');
      const options = Array.from(selectEl.options).map(o => o.value);
      selectEl.value = options.includes(appState.courseName) ? appState.courseName : 'custom';
    }

    function applyCoursePreset() {
      const val = document.getElementById('selectCoursePreset').value;
      if (val !== 'custom') {
        document.getElementById('inputCourseName').value = val;
      }
    }

    function saveSettings() {
      const gymName = document.getElementById('inputGymName').value.trim() || DEFAULT_STATE.gymName;
      const gymSub = document.getElementById('inputGymSub').value.trim() || DEFAULT_STATE.gymSub;
      const memberName = document.getElementById('inputMemberName').value.trim() || DEFAULT_STATE.memberName;
      const memberNo = document.getElementById('inputMemberNo').value.trim() || DEFAULT_STATE.memberNo;
      const courseName = document.getElementById('inputCourseName').value.trim() || DEFAULT_STATE.courseName;
      const rewardText = document.getElementById('inputRewardText').value.trim() || DEFAULT_STATE.rewardText;
      const pinRaw = document.getElementById('inputStaffPin').value.trim();

      if (!/^\d{4}$/.test(pinRaw)) {
        showToast('PINコードは4桁の数字で入力してください');
        return;
      }

      appState.gymName = gymName;
      appState.gymSub = gymSub;
      appState.memberName = memberName;
      appState.memberNo = memberNo;
      appState.courseName = courseName;
      appState.rewardText = rewardText;
      appState.staffPin = pinRaw;

      saveState();
      renderAll();
      showToast('会員証の設定を保存しました');
      switchTab('card');
    }

    function openResetConfirmModal() {
      openConfirmModal(
        'データの初期化',
        '現在のスタンプ・履歴・獲得済み特典・カスタマイズ設定をすべてリセットして初期状態に戻しますか？',
        () => {
          localStorage.removeItem(STORAGE_KEY);
          appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
          saveState();
          renderAll();
          showToast('データを初期化しました');
          switchTab('card');
        }
      );
    }

    // ==========================================
    // 7. 汎用モーダル・トースト・ユーティリティ
    // ==========================================
    function openConfirmModal(title, desc, onConfirm) {
      document.getElementById('confirmModalTitle').textContent = title;
      document.getElementById('confirmModalDesc').textContent = desc;
      pendingConfirmAction = onConfirm;
      document.getElementById('confirmModal').classList.remove('hidden');
    }

    function closeConfirmModal() {
      document.getElementById('confirmModal').classList.add('hidden');
      pendingConfirmAction = null;
    }

    document.getElementById('confirmModalOkBtn').addEventListener('click', () => {
      if (typeof pendingConfirmAction === 'function') {
        pendingConfirmAction();
      }
      closeConfirmModal();
    });

    let toastTimer = null;
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastText').textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2500);
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
